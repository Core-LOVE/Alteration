{
  "package": "io.github.katebulka.alteration.mixin",
  "required": true,
  "minVersion": "0.8",
  "compatibilityLevel": "${java}",
  "plugin": "io.github.katebulka.alteration.AlterationMixinPlugin",
  "injectors": {
    "defaultRequire": 1
  },
  "mixins": [
    "accessor.TrapDoorBlockAccessor",

    "ItemEntityMixin",
    "BlockBehaviourMixin",
    "EntityMixin",
    "LivingEntityMixin",
    "ServerPlayerMixin",
    "PistonStructureResolverMixin"
  ],
  "client": [
    "client.GuiMixin",
    "client.AbstractButtonMixin",
    "client.AbstractSliderButtonMixin",
    "client.ParticleMixin",
    "client.ArmorTrimMixin",
    "client.ItemStackMixin",
    "client.SoundManagerMixin",
    "client.AbstractCandleBlockMixin",
    "client.FallingBlockRendererMixin",

    "sodium.SmoothLightPipelineMixin",
    "clayworks.DecoratedPotTrimMixin",
    "supplementaries.CandleHolderBlockMixin"
  ]
}
